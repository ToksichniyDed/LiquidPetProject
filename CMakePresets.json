{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug-gcc",
      "displayName": "Debug (GCC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug-gcc",
      "toolchainFile": "${sourceDir}/build/debug-gcc/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "release-gcc",
      "displayName": "Release (GCC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-gcc",
      "toolchainFile": "${sourceDir}/build/release-gcc/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug-gcc", "configurePreset": "debug-gcc" },
    { "name": "release-gcc", "configurePreset": "release-gcc" }
  ]
}